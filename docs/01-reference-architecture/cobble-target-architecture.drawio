<mxCell id="c41" value="&lt;b style=&quot;font-size:12px&quot;&gt;Second copy in Melbourne&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Plus a timed restore test. The Region guardrail blocks Melbourne today&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;spacingTop=1;fontSize=12;fontColor=#5F6B7A;fillColor=#F4F5F7;strokeColor=#8D99A8;strokeWidth=2;dashed=1;dashPattern=2 3;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="c38"><mxGeometry x="12" y="132" width="241" height="76" as="geometry"/></mxCell>
