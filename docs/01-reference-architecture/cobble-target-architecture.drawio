<mxCell id="c29" value="&lt;b style=&quot;font-size:12px&quot;&gt;1-year log lock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Object Lock. The demo used 1 day so it could be torn down&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=46;spacingRight=6;spacingTop=1;fontSize=12;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#0972D3;strokeWidth=2;dashed=1;dashPattern=8 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="c26"><mxGeometry x="214" y="48" width="194" height="76" as="geometry"/></mxCell>
